// Shared build settings. Override per machine in Config/Local.xcconfig (git-ignored).
BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
// macOS App Group in team-prefixed form: needs only a development certificate, no provisioning profile.
APP_GROUP_ID = $(DEVELOPMENT_TEAM).$(BUNDLE_ID_PREFIX).SamsungReminder

#include? "Local.xcconfig"
